-- ═══════ КОНФИГ (переопределяется через _G.MM2Config) ═══════
local Config = _G.MM2Config or {
    FPSCap         = 15,
    AutoStartDelay = 5,
    RoundLimit     = 40,
    DebugPrints    = true,
    UseGUI         = true,      -- true = GUI, false = только консоль
    AutoFarm       = false,     -- true = стартовать фарм сразу
    CoinFolderNames = {
        "CoinContainer", "Coins", "CoinSpawner", "Coins_Server",
        "Spawns", "SummerCoins", "EventCoins", "Coin_Server",
    },
}

-- ═══════ ЗАЩИТА ОТ ПОВТОРНОГО ЗАПУСКА ═══════
if _G.MM2v11Loaded then return end
_G.MM2v11Loaded = true

-- ═══════ СЕРВИСЫ ═══════
local Players      = game:GetService("Players")
local Workspace    = game:GetService("Workspace")
local Stats        = game:GetService("Stats")
local RunService   = game:GetService("RunService")
local Lighting     = game:GetService("Lighting")
local player       = Players.LocalPlayer

-- ═══════ СОСТОЯНИЕ ═══════
local State = {
    Farming         = false,
    RoundStartCoins = 0,
    RoundCollected  = 0,
    LastFolder      = nil,
    IsLobby         = true,
    HRP             = nil,
    CPUOptimized    = false,
    FPSOptimized    = false,
    Noclip          = false,
    PStand          = false,
}

-- ═══════ ГЛОБАЛЬНЫЕ ПЕРЕМЕННЫЕ ═══════
_G.MM2Stop       = false
_G.MM2Status     = "INIT"
_G.MM2Round      = 0
_G.MM2Total      = 0
_G.MM2StartCoins = 0

-- ═══════ ЛОГ ═══════
local function log(...)
    if Config.DebugPrints then
        print("[MM2v11]", ...)
    end
end

-- ═══════ GUI ═══════
local GUI = {}

if Config.UseGUI then
    local success, err = pcall(function()
        local hui = gethui()
        local old = hui:FindFirstChild("MM2v11")
        if old then old:Destroy() end

        local gui = Instance.new("ScreenGui")
        gui.Name = "MM2v11"
        gui.ResetOnSpawn = false
        gui.Parent = hui

        local main = Instance.new("Frame")
        main.Size = UDim2.new(0, 300, 0, 400)
        main.Position = UDim2.new(0, 20, 0, 20)
        main.BackgroundColor3 = Color3.fromRGB(20, 20, 25)
        main.BorderColor3 = Color3.fromRGB(0, 255, 128)
        main.BorderSizePixel = 2
        main.Active = true
        main.Draggable = true
        main.Parent = gui

        -- Заголовок
        local title = Instance.new("TextLabel")
        title.Size = UDim2.new(1, 0, 0, 30)
        title.BackgroundColor3 = Color3.fromRGB(0, 255, 128)
        title.Text = "  MM2 FARM v11"
        title.TextColor3 = Color3.fromRGB(0, 0, 0)
        title.Font = Enum.Font.SourceSansBold
        title.TextSize = 18
        title.TextXAlignment = Enum.TextXAlignment.Left
        title.Parent = main

        -- Утилита кнопок
        local function makeBtn(txt, y, r, g, b)
            local btn = Instance.new("TextButton")
            btn.Size = UDim2.new(0, 260, 0, 34)
            btn.Position = UDim2.new(0, 20, 0, y)
            btn.BackgroundColor3 = Color3.fromRGB(r, g, b)
            btn.Text = txt
            btn.TextColor3 = Color3.new(1, 1, 1)
            btn.Font = Enum.Font.SourceSansBold
            btn.TextSize = 14
            btn.Parent = main
            return btn
        end

        local function makeLbl(txt, y, col)
            local l = Instance.new("TextLabel")
            l.Size = UDim2.new(0, 260, 0, 20)
            l.Position = UDim2.new(0, 20, 0, y)
            l.BackgroundTransparency = 1
            l.Text = txt
            l.TextColor3 = col or Color3.fromRGB(255, 255, 255)
            l.Font = Enum.Font.Code
            l.TextSize = 13
            l.TextXAlignment = Enum.TextXAlignment.Left
            l.Parent = main
            return l
        end

        -- Кнопки
        GUI.btnFarm   = makeBtn("⏵ Auto Farm: OFF", 40, 120, 40, 40)
        GUI.btnCPU    = makeBtn("🖥 CPU Nuke: OFF", 80, 40, 60, 100)
        GUI.btnFPS    = makeBtn("📉 FPS Cap: OFF", 120, 40, 100, 40)
        GUI.btnNoclip = makeBtn("👻 Noclip: OFF", 160, 100, 80, 30)
        GUI.btnPstand = makeBtn("🧍 PStand: OFF", 200, 80, 60, 80)

        -- Статусы
        GUI.lblStatus = makeLbl("Status: READY", 240, Color3.fromRGB(0, 255, 128))
        GUI.lblRound  = makeLbl("Round: 0/40", 262, Color3.fromRGB(255, 255, 0))
        GUI.lblTotal  = makeLbl("Total: --", 284, Color3.fromRGB(0, 200, 255))
        GUI.lblPing   = makeLbl("Ping: --", 306, Color3.fromRGB(200, 200, 200))
        GUI.lblDebug  = makeLbl("Debug: GUI loaded", 328, Color3.fromRGB(150, 150, 150))
        GUI.lblJob    = makeLbl("ID: " .. game.JobId:sub(1, 8), 350, Color3.fromRGB(100, 100, 100))

        log("GUI создан")
    end)

    if not success then
        log("GUI не создан:", err)
        Config.UseGUI = false
    end
end

-- ═══════ ОПТИМИЗАЦИЯ ПЕРСОНАЖА ═══════
local function optimizeCharacter(char)
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum then
        hum.PlatformStand = State.PStand
        hum.AutoRotate = not State.PStand
    end
    for _, obj in pairs(char:GetDescendants()) do
        if obj:IsA("BasePart") then
            obj.CastShadow = false
            if State.Noclip then
                obj.CanCollide = false
                obj.Massless = true
            else
                obj.CanCollide = true
                obj.Massless = false
            end
        end
    end
    State.HRP = char:FindFirstChild("HumanoidRootPart")
end

player.CharacterAdded:Connect(function(char)
    task.wait(0.5)
    optimizeCharacter(char)
end)
if player.Character then optimizeCharacter(player.Character) end

-- ═══════ УТИЛИТЫ ═══════
local function getCoinFolder()
    for _, name in ipairs(Config.CoinFolderNames) do
        local f = Workspace:FindFirstChild(name)
        if f then return f end
    end
    local map = Workspace:FindFirstChild("Map")
    if map then
        for _, name in ipairs(Config.CoinFolderNames) do
            local f = map:FindFirstChild(name)
            if f then return f end
        end
    end
    return nil
end

local function getLeaderCoins()
    local ls = player:FindFirstChild("leaderstats")
    if not ls then return nil end
    local c = ls:FindFirstChild("Coins") or ls:FindFirstChild("coins")
    if c and c:IsA("IntValue") then return c.Value end
    return nil
end

local function updateGlobals(status)
    _G.MM2Status     = status or _G.MM2Status
    _G.MM2Round      = State.RoundCollected
    _G.MM2Total      = getLeaderCoins() or _G.MM2Total
    _G.MM2StartCoins = State.RoundStartCoins

    if Config.UseGUI then
        pcall(function()
            GUI.lblStatus.Text = "Status: " .. _G.MM2Status
            GUI.lblRound.Text  = "Round: " .. State.RoundCollected .. "/" .. Config.RoundLimit
            GUI.lblTotal.Text  = "Total: " .. (_G.MM2Total ~= 0 and _G.MM2Total or "--")

            local p = 0
            pcall(function()
                p = math.floor(Stats.Network.ServerStatsItem["Data Ping"]:GetValue())
            end)
            GUI.lblPing.Text = "Ping: " .. p .. "ms"
        end)
    end
end

local function randomDelay(min, max)
    task.wait(math.random(math.floor(min * 10), math.floor(max * 10)) / 10)
end

-- ═══════ ОБРАБОТЧИКИ КНОПОК ═══════
if Config.UseGUI then
    GUI.btnFarm.MouseButton1Click:Connect(function()
        State.Farming = not State.Farming
        GUI.btnFarm.Text = State.Farming and "⏹ Auto Farm: ON" or "⏵ Auto Farm: OFF"
        GUI.btnFarm.BackgroundColor3 = State.Farming and Color3.fromRGB(40, 150, 40) or Color3.fromRGB(120, 40, 40)
        log("Farm:", State.Farming and "ON" or "OFF")
    end)

    GUI.btnCPU.MouseButton1Click:Connect(function()
        State.CPUOptimized = not State.CPUOptimized
        GUI.btnCPU.Text = State.CPUOptimized and "🖥 CPU Nuke: ON" or "🖥 CPU Nuke: OFF"
        GUI.btnCPU.BackgroundColor3 = State.CPUOptimized and Color3.fromRGB(120, 40, 40) or Color3.fromRGB(40, 60, 100)

        if State.CPUOptimized then
            pcall(function() RunService:Set3dRenderingEnabled(false) end)
            for _, obj in pairs(Workspace:GetDescendants()) do
                if obj:IsA("ParticleEmitter") or obj:IsA("Trail") or obj:IsA("Beam") or obj:IsA("Sound") or obj:IsA("Explosion") then
                    pcall(function() obj:Destroy() end)
                elseif obj:IsA("BasePart") then
                    obj.CastShadow = false
                end
            end
            Lighting.GlobalShadows = false
            log("CPU Nuke ON")
        else
            pcall(function() RunService:Set3dRenderingEnabled(true) end)
            log("CPU Nuke OFF")
        end
    end)

    GUI.btnFPS.MouseButton1Click:Connect(function()
        State.FPSOptimized = not State.FPSOptimized
        GUI.btnFPS.Text = State.FPSOptimized and "📉 FPS Cap: 15" or "📉 FPS Cap: OFF"
        GUI.btnFPS.BackgroundColor3 = State.FPSOptimized and Color3.fromRGB(40, 150, 40) or Color3.fromRGB(40, 100, 40)
        pcall(function() setfpscap(State.FPSOptimized and 15 or 60) end)
        log("FPS:", State.FPSOptimized and "15" or "60")
    end)

    GUI.btnNoclip.MouseButton1Click:Connect(function()
        State.Noclip = not State.Noclip
        GUI.btnNoclip.Text = State.Noclip and "👻 Noclip: ON" or "👻 Noclip: OFF"
        GUI.btnNoclip.BackgroundColor3 = State.Noclip and Color3.fromRGB(150, 120, 40) or Color3.fromRGB(100, 80, 30)
        if player.Character then optimizeCharacter(player.Character) end
    end)

    GUI.btnPstand.MouseButton1Click:Connect(function()
        State.PStand = not State.PStand
        GUI.btnPstand.Text = State.PStand and "🧍 PStand: ON" or "🧍 PStand: OFF"
        GUI.btnPstand.BackgroundColor3 = State.PStand and Color3.fromRGB(120, 90, 120) or Color3.fromRGB(80, 60, 80)
        if player.Character then optimizeCharacter(player.Character) end
    end)
end

-- ═══════ ФАРМ ЦИКЛ ═══════
task.wait(Config.AutoStartDelay)

if Config.AutoFarm then
    State.Farming = true
    if Config.UseGUI then
        GUI.btnFarm.Text = "⏹ Auto Farm: ON"
        GUI.btnFarm.BackgroundColor3 = Color3.fromRGB(40, 150, 40)
    end
end

log("=== ФАРМ ГОТОВ ===")
log("Команды: _G.MM2Stop = true/false")

while true do
    if _G.MM2Stop then
        if State.Farming then
            State.Farming = false
            updateGlobals("STOPPED")
            log("Остановлено")
        end
        task.wait(1)
        continue
    end

    local folder = getCoinFolder()

    -- Новый раунд
    if folder and folder ~= State.LastFolder then
        State.LastFolder      = folder
        State.RoundCollected  = 0
        State.RoundStartCoins = getLeaderCoins() or 0
        State.IsLobby         = false
        updateGlobals("FARMING")
        log("Новый раунд | Старт:", State.RoundStartCoins)
    end

    -- Лобби
    if not folder or not folder.Parent then
        if not State.IsLobby then
            State.IsLobby = true
            State.LastFolder = nil
            updateGlobals("LOBBY")
            log("Лобби...")
        end
        task.wait(2)
        continue
    end

    -- Лимит 40
    local current = getLeaderCoins()
    if current and State.RoundStartCoins and (current - State.RoundStartCoins) >= Config.RoundLimit then
        if _G.MM2Status ~= "LIMIT_40" then
            updateGlobals("LIMIT_40")
            log("Лимит", Config.RoundLimit, "| Всего:", current)
        end
        task.wait(3)
        continue
    end

    if State.Farming then
        updateGlobals("FARMING")

        if not State.HRP or not State.HRP.Parent then
            local char = player.Character
            if char then State.HRP = char:FindFirstChild("HumanoidRootPart") end
            if not State.HRP then task.wait(1) continue end
        end

        local coins = {}
        for _, obj in pairs(folder:GetChildren()) do
            if obj:IsA("BasePart") and obj.Parent then
                table.insert(coins, obj)
            end
        end

        if #coins == 0 then
            task.wait(0.5)
            continue
        end

        table.sort(coins, function(a, b)
            return (a.Position - State.HRP.Position).Magnitude < (b.Position - State.HRP.Position).Magnitude
        end)

        for _, coin in ipairs(coins) do
            if _G.MM2Stop then break end
            if not State.Farming then break end
            if not coin.Parent then continue end

            local now = getLeaderCoins()
            if now and State.RoundStartCoins and (now - State.RoundStartCoins) >= Config.RoundLimit then break end

            if not State.HRP or not State.HRP.Parent then break end

            pcall(function()
                State.HRP.CFrame = coin.CFrame + Vector3.new(0, 2, 0)
            end)

            randomDelay(0.4, 0.8)

            if not coin.Parent then
                State.RoundCollected = State.RoundCollected + 1
            end

            randomDelay(0.5, 1.0)
        end
    else
        updateGlobals("IDLE")
        task.wait(1)
    end
end
