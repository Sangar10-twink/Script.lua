--[[
    MM2 CPU Optimizer v1 | Модуль для совместного использования с Vertex
    Цель: Минимизировать CPU usage, оставить 20 FPS
    НЕ делает фарм — только оптимизацию движка
]]

if _G.MM2CPUOptLoaded then return end
_G.MM2CPUOptLoaded = true

-- ═══════ КОНФИГ ═══════
local Config = {
    FPSCap          = 20,       -- Твой запрос: 20 FPS
    FreezeCharacter = true,     -- Убрать физику персонажа
    StripCharacter  = true,     -- Удалить лишние детали с персонажа
    DisableAudio    = true,     -- Отключить звук (CPU на декодирование)
    ReduceMapEffects = true,    -- Удалить частицы/трейлы с карты
    CacheReferences = true,     -- Кешировать частые поиски
}

-- ═══════ СЕРВИСЫ ═══════
local Players       = game:GetService("Players")
local Workspace     = game:GetService("Workspace")
local Lighting      = game:GetService("Lighting")
local RunService    = game:GetService("RunService")
local SoundService  = game:GetService("SoundService")
local player        = Players.LocalPlayer

-- ═══════ 1. FPS CAP = 20 ═══════
if typeof(setfpscap) == "function" then
    pcall(function()
        setfpscap(Config.FPSCap)
        print("[CPU Opt] FPS capped to", Config.FPSCap)
    end)
end

-- ═══════ 2. ОТКЛЮЧИТЬ НЕНУЖНЫЕ СОБЫТИЯ ═══════
-- Отписываемся от RenderStepped если что-то подписано (не трогаем чужие скрипты)
-- Но можем замедлить свои Heartbeat
pcall(function()
    -- Уменьшаем частоту физики (если возможно)
    settings().Physics.PhysicsEnvironmentalThrottle = Enum.EnviromentalPhysicsThrottle.Disabled
end)

-- ═══════ 3. ЗАМОРОЗИТЬ ПЕРСОНАЖА (ГЛАВНОЕ ДЛЯ CPU) ═══════
local function optimizeCharacter(char)
    if not char then return end
    
    -- Убираем всё лишнее с персонажа (уменьшает количество объектов для обработки)
    if Config.StripCharacter then
        for _, obj in pairs(char:GetDescendants()) do
            if obj:IsA("BasePart") then
                obj.CastShadow = false
                -- Минимальный размер коллизий уменьшает физику
                -- НЕ трогаем CanCollide (провалишься)
            elseif obj:IsA("Decal") or obj:IsA("Texture") then
                obj:Destroy()  -- Меньше объектов = меньше рендеринга и памяти
            elseif obj:IsA("ParticleEmitter") or obj:IsA("Trail") 
                or obj:IsA("BillboardGui") or obj:IsA("SurfaceGui") then
                obj:Destroy()
            elseif obj:IsA("Sound") then
                obj:Destroy()
            end
        end
    end
    
    -- PlatformStand — отключает физику движения персонажа
    -- Это САМОЕ ВАЖНОЕ для CPU: humanoid не считает гравитацию, коллизии, анимации
    if Config.FreezeCharacter then
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then
            hum.PlatformStand = true
            hum.AutoRotate = false
            hum.WalkSpeed = 0
            hum.JumpPower = 0
            -- Отключаем состояния (бег, прыжок, падение)
            hum:SetStateEnabled(Enum.HumanoidStateType.Running, false)
            hum:SetStateEnabled(Enum.HumanoidStateType.Jumping, false)
            hum:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
            hum:SetStateEnabled(Enum.HumanoidStateType.GettingUp, false)
        end
        
        -- Удаляем Animator — он запускает анимации каждый кадр
        local animator = char:FindFirstChild("Animator", true)
        if animator then
            animator:Destroy()
        end
        
        -- Удаляем AnimationController если есть
        local animController = char:FindFirstChildOfClass("AnimationController")
        if animController then
            animController:Destroy()
        end
    end
end

player.CharacterAdded:Connect(function(char)
    task.wait(0.5)
    optimizeCharacter(char)
end)

if player.Character then
    optimizeCharacter(char)
end

-- ═══════ 4. ОТКЛЮЧИТЬ ЗВУК (CPU на декодирование аудио) ═══════
if Config.DisableAudio then
    pcall(function()
        SoundService.Volume = 0
        -- Удаляем все звуки
        for _, s in pairs(SoundService:GetDescendants()) do
            if s:IsA("Sound") then
                s:Destroy()
            end
        end
    end)
end

-- ═══════ 5. УБРАТЬ ЭФФЕКТЫ С КАРТЫ (одноразово) ═══════
if Config.ReduceMapEffects then
    task.spawn(function()
        task.wait(3)  -- Даём карте загрузиться
        
        local count = 0
        for _, obj in pairs(Workspace:GetDescendants()) do
            local t = obj:IsA("ParticleEmitter") or obj:IsA("Trail") 
                or obj:IsA("Smoke") or obj:IsA("Fire") 
                or obj:IsA("Sparkles") or obj:IsA("Beam")
                or obj:IsA("Explosion")
            if t then
                pcall(function()
                    obj:Destroy()
                    count = count + 1
                end)
            elseif obj:IsA("BasePart") then
                obj.CastShadow = false  -- Тени считаются на CPU
            end
        end
        
        print("[CPU Opt] Removed", count, "effects from map")
    end)
end

-- ═══════ 6. ОСВЕЩЕНИЕ (меньше вычислений) ═══════
pcall(function()
    Lighting.GlobalShadows = false
    Lighting.Outlines = false
    Lighting.Brightness = 1
    Lighting.ClockTime = 12  -- Стабильное освещение = меньше пересчётов
end)

-- ═══════ 7. КЕШИРОВАНИЕ (для скриптов которые делают поиски) ═══════
if Config.CacheReferences then
    -- Кешируем часто используемые сервисы и пути
    _G.CachedWorkspace = Workspace
    _G.CachedPlayers = Players
    _G.CachedLighting = Lighting
    
    -- Кешируем LocalPlayer (уже есть, но на всякий)
    _G.CachedLocalPlayer = player
    
    print("[CPU Opt] References cached")
end

