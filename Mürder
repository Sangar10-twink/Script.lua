--[[
    MM2 Ultra-Optimizer | Для 30+ инстансов Roblox
    Цель: Минимальный CPU/GPU/RAM usage
]]

if _G.MM2UltraOptLoaded then return end
_G.MM2UltraOptLoaded = true

-- ═══════ КОНФИГ ═══════
local Config = {
    FPSCap          = 5,     -- 5 FPS максимум (можно 3 для совсем слабых ПК)
    RenderDistance  = 10,    -- Дистанция прорисовки (студия)
    RemoveAllEffects = true, -- Удалить все эффекты с карты
    DisableAudio    = true,  -- Отключить звук полностью
    FreezeCharacter = true,  -- Полная заморозка персонажа
    LowQualityMode  = true,  -- Минимальное качество графики
}

-- ═══════ СЕРВИСЫ ═══════
local Players       = game:GetService("Players")
local Workspace     = game:GetService("Workspace")
local Lighting      = game:GetService("Lighting")
local RunService    = game:GetService("RunService")
local SoundService  = game:GetService("SoundService")
local StarterGui    = game:GetService("StarterGui")
local player        = Players.LocalPlayer

-- ═══════ 1. FPS CAP (САМОЕ ВАЖНОЕ) ═══════
if typeof(setfpscap) == "function" then
    pcall(function()
        setfpscap(Config.FPSCap)
        print("[UltraOpt] FPS capped to", Config.FPSCap)
    end)
end

-- ═══════ 2. ОТКЛЮЧИТЬ ВСЕ СОБЫТИЯ РЕНДЕРИНГА ═══════
-- Это убивает визуал, но спасает CPU
pcall(function()
    RunService:Set3dRenderingEnabled(false)  -- Полностью отключает 3D рендеринг!
end)

-- ═══════ 3. ОТКЛЮЧИТЬ ЗВУК ═══════
if Config.DisableAudio then
    pcall(function()
        SoundService.RespectFilteringEnabled = true
        for _, s in pairs(SoundService:GetDescendants()) do
            if s:IsA("Sound") then s:Destroy() end
        end
        SoundService.Volume = 0
    end)
end

-- ═══════ 4. МИНИМАЛЬНОЕ ОСВЕЩЕНИЕ ═══════
pcall(function()
    Lighting.GlobalShadows = false
    Lighting.Outlines = false
    Lighting.Brightness = 0
    Lighting.ClockTime = 12  -- Полдень = меньше вычислений освещения
    Lighting.FogEnd = 0
    Lighting.FogStart = 0
end)

-- ═══════ 5. ЗАМОРОЗИТЬ ПЕРСОНАЖА ПОЛНОСТЬЮ ═══════
local function freezeCharacter(char)
    if not char then return end
    
    -- Убираем тени
    for _, obj in pairs(char:GetDescendants()) do
        if obj:IsA("BasePart") then
            obj.CastShadow = false
            obj.CanCollide = false  -- Не считать коллизии
            obj.Material = Enum.Material.SmoothPlastic  -- Простейший материал
        elseif obj:IsA("Decal") or obj:IsA("Texture") then
            obj:Destroy()  -- Удалить текстуры
        elseif obj:IsA("ParticleEmitter") or obj:IsA("Trail") then
            obj:Destroy()  -- Удалить частицы
        elseif obj:IsA("BillboardGui") or obj:IsA("SurfaceGui") then
            obj:Destroy()  -- Удалить GUI на персонаже
        end
    end
    
    -- PlatformStand + отключить анимации
    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum then
        hum.PlatformStand = true
        hum.AutoRotate = false
        hum.WalkSpeed = 0
        hum.JumpPower = 0
    end
    
    -- Удалить аниматор
    local animator = char:FindFirstChild("Animator", true)
    if animator then animator:Destroy() end
end

player.CharacterAdded:Connect(function(char)
    task.wait(0.5)
    freezeCharacter(char)
end)

if player.Character then
    freezeCharacter(player.Character)
end

-- ═══════ 6. ОЧИСТИТЬ КАРТУ ОТ ЭФФЕКТОВ ═══════
if Config.RemoveAllEffects then
    task.spawn(function()
        task.wait(3)
        for _, obj in pairs(Workspace:GetDescendants()) do
            if obj:IsA("ParticleEmitter") 
            or obj:IsA("Trail") 
            or obj:IsA("Smoke") 
            or obj:IsA("Fire") 
            or obj:IsA("Sparkles")
            or obj:IsA("Beam")
            or obj:IsA("Explosion") then
                pcall(function() obj:Destroy() end)
            elseif obj:IsA("BasePart") then
                obj.CastShadow = false
                if obj.Name ~= "HumanoidRootPart" and obj.Name ~= "Head" then
                    obj.Transparency = 1  -- Сделать невидимым
                end
            elseif obj:IsA("Decal") or obj:IsA("Texture") then
                obj:Destroy()
            elseif obj:IsA("Sound") then
                obj:Destroy()
            end
        end
        print("[UltraOpt] Map cleaned")
    end)
end

-- ═══════ 7. ОТКЛЮЧИТЬ GUI (чат, меню и т.д.) ═══════
pcall(function()
    StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.All, false)
end)

-- ═══════ 8. УБРАТЬ КАМЕРУ (не рендерить сцену) ═══════
pcall(function()
    Workspace.CurrentCamera.CameraType = Enum.CameraType.Scriptable
    Workspace.CurrentCamera.CFrame = CFrame.new(0, 10000, 0)  -- Улететь в небо
end)

print("[UltraOpt] Загружено | Инстанс максимально оптимизирован")
