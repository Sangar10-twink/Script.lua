--[[
    MM2 Client Optimizer v3

    Только локальная оптимизация клиента.
    Не управляет персонажем и не изменяет игровую физику.

    Возможности:
    - FPS cap
    - отключение аудио
    - отключение визуальных эффектов
    - отключение теней
    - опциональное отключение Animator

    Не делает:
    - фарм
    - телепорты
    - PlatformStand
    - изменение CanCollide
    - изменение физики
]]

if _G.MM2CPUOptLoaded then
    return
end

_G.MM2CPUOptLoaded = true

-- =========================================================
-- CONFIG
-- =========================================================

local Config = {
    FPSCap = 18,            -- Тестируй 18 / 17 / 16 / 15

    DisableAudio = true,
    RemoveEffects = true,
    RemoveShadows = true,

    -- Лучше оставить false.
    -- Включай только отдельно для теста.
    RemoveAnimator = false,
}

-- =========================================================
-- SERVICES
-- =========================================================

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local SoundService = game:GetService("SoundService")

local LocalPlayer = Players.LocalPlayer

-- =========================================================
-- FPS
-- =========================================================

if typeof(setfpscap) == "function" then
    pcall(function()
        setfpscap(Config.FPSCap)
    end)
end

-- =========================================================
-- AUDIO
-- =========================================================

if Config.DisableAudio then
    pcall(function()
        SoundService.Volume = 0
    end)
end

-- =========================================================
-- EFFECT CHECK
-- =========================================================

local function disableEffect(object)
    if not Config.RemoveEffects then
        return
    end

    if object:IsA("ParticleEmitter")
        or object:IsA("Trail")
        or object:IsA("Smoke")
        or object:IsA("Fire")
        or object:IsA("Sparkles")
        or object:IsA("Beam") then

        pcall(function()
            object.Enabled = false
        end)
    end
end

-- =========================================================
-- PART OPTIMIZATION
-- =========================================================

local function optimizePart(object)
    if not Config.RemoveShadows then
        return
    end

    if object:IsA("BasePart") then
        pcall(function()
            object.CastShadow = false
        end)
    end
end

-- =========================================================
-- CHARACTER OPTIMIZATION
-- =========================================================

local function optimizeCharacter(character)
    if not character then
        return
    end

    for _, object in ipairs(character:GetDescendants()) do

        if object:IsA("BasePart") then

            if Config.RemoveShadows then
                pcall(function()
                    object.CastShadow = false
                end)
            end

        elseif object:IsA("BillboardGui")
            or object:IsA("SurfaceGui")
            or object:IsA("Decal")
            or object:IsA("Texture")
            or object:IsA("ParticleEmitter")
            or object:IsA("Trail") then

            pcall(function()
                object:Destroy()
            end)

        elseif object:IsA("Sound") and Config.DisableAudio then

            pcall(function()
                object:Destroy()
            end)
        end
    end

    -- Animator отключён по умолчанию.
    if Config.RemoveAnimator then
        local animator = character:FindFirstChildOfClass("Animator")

        if animator then
            pcall(function()
                animator:Destroy()
            end)
        end
    end
end

-- =========================================================
-- CHARACTER EVENTS
-- =========================================================

LocalPlayer.CharacterAdded:Connect(function(character)

    task.wait(0.5)

    optimizeCharacter(character)

end)

if LocalPlayer.Character then
    optimizeCharacter(LocalPlayer.Character)
end

-- =========================================================
-- INITIAL WORKSPACE OPTIMIZATION
-- =========================================================

if Config.RemoveEffects or Config.RemoveShadows then

    task.spawn(function()

        task.wait(3)

        for _, object in ipairs(Workspace:GetDescendants()) do

            disableEffect(object)
            optimizePart(object)

        end

    end)

end

-- =========================================================
-- NEW OBJECTS
-- =========================================================

if Config.RemoveEffects or Config.RemoveShadows then

    Workspace.DescendantAdded:Connect(function(object)

        disableEffect(object)
        optimizePart(object)

    end)

end

-- =========================================================
-- DONE
-- =========================================================

print(
    "[MM2 Optimizer v3]",
    "FPS:", Config.FPSCap,
    "Audio:", Config.DisableAudio,
    "Effects:", Config.RemoveEffects,
    "Shadows:", Config.RemoveShadows,
    "Animator:", Config.RemoveAnimator
)
