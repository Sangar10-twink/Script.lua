-- ========== НАСТРОЙКИ ==========
local SETTINGS = {
    espEnabled = true,           -- видеть сквозь стены
    aimEnabled = true,           -- автоприцел
    autoShoot = true,            -- авто-стрельба
    wallbang = true,             -- стрелять сквозь стены
    autoFarmEvents = true,       -- сбор ивентов/квестов
    aimSmooth = 0.15,            -- плавность прицела (0.1 = быстро, 0.5 = медленно)
    aimFov = 200,                -- радиус захвата (пиксели)
    targetBots = true,           -- целиться только в ботов
    targetPlayers = false,       -- целиться в игроков (опасно)
    maxDistance = 500,           -- макс дистанция
    espColor = Color3.fromRGB(255, 0, 0), -- цвет ESP
    botTag = "Bot",              -- как отличать ботов (по имени/тегу)
}

-- ========== ESP СИСТЕМА ==========
local espObjects = {}

local function createESP(character)
    if not character then return end
    
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    local head = character:FindFirstChild("Head")
    if not humanoid or not head then return end
    
    -- Проверяем, бот ли это
    local isBot = false
    local nameTag = character:FindFirstChild("NameTag") or head:FindFirstChild("NameTag")
    if nameTag and nameTag:IsA("BillboardGui") then
        local text = nameTag:FindFirstChildOfClass("TextLabel")
        if text and (text.Text:find("Bot") or text.Text:find("NPC")) then
            isBot = true
        end
    end
    
    -- Если целимся только в ботов, а это игрок — пропускаем
    if SETTINGS.targetBots and not isBot then return end
    if not SETTINGS.targetPlayers and not isBot then return end
    
    -- Создаём ESP рамку
    local box = Instance.new("BoxHandleAdornment")
    box.Size = character:GetExtentsSize()
    box.Color3 = SETTINGS.espColor
    box.Transparency = 0.5
    box.ZIndex = 10
    box.AlwaysOnTop = true
    box.Adornee = character
    box.Parent = character
    
    -- Линия к цели
    local line = Drawing.new("Line")
    line.Visible = true
    line.Color = SETTINGS.espColor
    line.Thickness = 1
    line.Transparency = 0.7
    
    espObjects[character] = {
        box = box,
        line = line,
        isBot = isBot,
        head = head
    }
end

-- Обновление ESP
RunService.RenderStepped:Connect(function()
    for char, data in pairs(espObjects) do
        if not char or not char.Parent then
            if data.line then data.line:Remove() end
            espObjects[char] = nil
            continue
        end
        
        local headPos = data.head and data.head.Position
        if headPos then
            local screenPos, onScreen = Camera:WorldToViewportPoint(headPos)
            if onScreen then
                data.line.From = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
                data.line.To = Vector2.new(screenPos.X, screenPos.Y)
                data.line.Visible = true
            else
                data.line.Visible = false
            end
        end
    end
end)

-- Следим за новыми персонажами
for _, p in ipairs(Players:GetPlayers()) do
    if p ~= player and p.Character then
        createESP(p.Character)
    end
    p.CharacterAdded:Connect(function(char)
        task.wait(1) -- даём загрузиться
        createESP(char)
    end)
end

Players.PlayerAdded:Connect(function(p)
    p.CharacterAdded:Connect(function(char)
        task.wait(1)
        createESP(char)
    end)
end)

-- ========== AIMBOT ==========
local function getClosestTarget()
    local closest = nil
    local closestDist = SETTINGS.aimFov
    local mousePos = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    
    for char, data in pairs(espObjects) do
        if not char or not char.Parent then continue end
        if not data.head then continue end
        
        local headPos = data.head.Position
        local distance = (player.Character and player.Character:FindFirstChild("HumanoidRootPart") 
            and (player.Character.HumanoidRootPart.Position - headPos).Magnitude or 0)
        
        if distance > SETTINGS.maxDistance then continue end
        
        local screenPos, onScreen = Camera:WorldToViewportPoint(headPos)
        if not onScreen then continue end
        
        local screenDist = (Vector2.new(screenPos.X, screenPos.Y) - mousePos).Magnitude
        
        if screenDist < closestDist then
            closestDist = screenDist
            closest = data.head
        end
    end
    
    return closest
end

RunService.RenderStepped:Connect(function()
    if not SETTINGS.aimEnabled then return end
    
    local target = getClosestTarget()
    if target then
        local pos = Camera:WorldToViewportPoint(target.Position)
        local mousePos = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
        local move = (Vector2.new(pos.X, pos.Y) - mousePos) * SETTINGS.aimSmooth
        
        -- Двигаем камеру
        local currentCF = Camera.CFrame
        local targetCF = CFrame.new(currentCF.Position, target.Position)
        Camera.CFrame = currentCF:Lerp(targetCF, SETTINGS.aimSmooth)
        
        -- Авто-стрельба
        if SETTINGS.autoShoot then
            local tool = player.Character and player.Character:FindFirstChildOfClass("Tool")
            if tool then
                pcall(function()
                    tool:Activate()
                end)
            end
        end
    end
end)

-- ========== АВТО-ФАРМ ИВЕНТОВ ==========
local function findAndClick(textPattern, searchAllGui)
    for _, gui in ipairs(player.PlayerGui:GetChildren()) do
        for _, obj in ipairs(gui:GetDescendants()) do
            if obj:IsA("TextButton") or obj:IsA("ImageButton") then
                local txt = ""
                if obj:IsA("TextButton") then txt = obj.Text or "" end
                
                if txt:lower():find(textPattern:lower()) or obj.Name:lower():find(textPattern:lower()) then
                    -- Имитируем клик
                    pcall(function()
                        for _, conn in ipairs(getconnections(obj.MouseButton1Click)) do
                            if conn.Function then conn.Function() end
                        end
                    end)
                    pcall(function() obj.MouseButton1Click:Fire() end)
                    return true, obj.Name, txt
                end
            end
        end
    end
    return false, nil, nil
end

-- Сбор всех наград
local function collectAllRewards()
    if not SETTINGS.autoFarmEvents then return end
    
    local collected = 0
    
    -- Playtime награды
    local patterns = {"claim", "collect", "get", "reward", "complete", "500", "300", "100", "200"}
    
    for _, pattern in ipairs(patterns) do
        local ok, name, txt = findAndClick(pattern)
        if ok then
            collected = collected + 1
            print("[НАГРАДА] Собрано:", txt ~= "" and txt or name)
            task.wait(random(0.5, 1.5))
        end
    end
    
    if collected > 0 then
        print("Всего собрано наград:", collected)
    end
end

