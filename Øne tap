-- One Tap: Cosmic Case Auto-Buy
local Players = game:GetService("Players")
local player = Players.LocalPlayer

print("=" .. string.rep("=", 50))
print("  ONE TAP: COSMIC CASE AUTO-BUY")
print("=" .. string.rep("=", 50))
print("ОТКРОЙ GUI Cosmic Case и скрипт найдёт кнопки!")

-- Ждём появления GUI кейса
local caseGui = nil
local maxWait = 30 -- ждём 30 секунд
local waited = 0

while not caseGui and waited < maxWait do
    -- Ищем во всех ScreenGui
    for _, gui in ipairs(player.PlayerGui:GetChildren()) do
        if gui:IsA("ScreenGui") or gui:IsA("Folder") then
            for _, obj in ipairs(gui:GetDescendants()) do
                -- Ищем по тексту "Cosmic" или по цене 20000
                if obj:IsA("TextLabel") or obj:IsA("TextButton") then
                    local txt = obj.Text or ""
                    if txt:find("Cosmic") or txt:find("20000") or txt:find("2000") then
                        caseGui = gui
                        print("\n[GUI НАЙДЕНО] Путь:", gui:GetFullName())
                        print("  Триггер:", obj.Name, "=", txt)
                        break
                    end
                end
            end
            if caseGui then break end
        end
    end
    
    if not caseGui then
        task.wait(1)
        waited = waited + 1
        if waited % 5 == 0 then
            print("  Ждём GUI... (", waited, "/", maxWait, ")")
        end
    end
end

if not caseGui then
    print("! GUI Cosmic Case не найдено за 30 секунд")
    print("Убедись, что открыл меню кейсов!")
    return
end

-- Сканируем все кнопки в найденном GUI
print("\n[СКАНИРОВАНИЕ КНОПОК]:")
local allButtons = {}
for _, obj in ipairs(caseGui:GetDescendants()) do
    if obj:IsA("TextButton") or obj:IsA("ImageButton") then
        local txt = ""
        if obj:IsA("TextButton") then txt = obj.Text end
        
        print("  Кнопка:", obj.Name)
        print("    Текст:", txt ~= "" and txt or "[ImageButton]")
        print("    Путь:", obj:GetFullName())
        
        table.insert(allButtons, {
            btn = obj,
            text = txt,
            path = obj:GetFullName()
        })
    end
end

-- Находим конкретно кнопку Buy 10 за $20000
local buy10Btn = nil
local buy1Btn = nil
local closeBtn = nil

for _, info in ipairs(allButtons) do
    local txt = info.text:lower()
    local name = info.btn.Name:lower()
    
    -- Ищем Buy 10 / 20000
    if txt:find("20000") or txt:find("20") and txt:find("000") 
       or name:find("buy10") or name:find("buy_10") or name:find("ten") then
        buy10Btn = info.btn
        print("\n[>> НАЙДЕНА КНОПКА BUY 10]:", info.btn.Name)
    end
    
    -- Ищем Buy 1 / 2000
    if txt:find("2000") and not txt:find("20000")
       or name:find("buy1") or name:find("buy_1") then
        buy1Btn = info.btn
        print("\n[>> НАЙДЕНА КНОПКА BUY 1]:", info.btn.Name)
    end
    
    -- Ищем Close
    if txt:find("close") or name:find("close") then
        closeBtn = info.btn
        print("\n[>> НАЙДЕНА КНОПКА CLOSE]:", info.btn.Name)
    end
end

-- === ФУНКЦИИ ДЛЯ КОНСОЛИ ===

-- Кликнуть по кнопке всеми возможными способами
local function clickButton(btn)
    local success = false
    
    -- Способ 1: Стандартный Fire
    pcall(function()
        btn.MouseButton1Click:Fire()
        success = true
    end)
    
    -- Способ 2: Activated
    pcall(function()
        if btn:FindFirstChild("Activated") then
            btn.Activated:Fire()
            success = true
        end
    end)
    
    -- Способ 3: Через connections
    pcall(function()
        for _, conn in ipairs(getconnections(btn.MouseButton1Click)) do
            if conn.Function then
                conn.Function()
                success = true
            end
        end
    end)
    
    -- Способ 4: Через Activated connections
    pcall(function()
        for _, conn in ipairs(getconnections(btn.Activated)) do
            if conn.Function then
                conn.Function()
                success = true
            end
        end
    end)
    
    return success
end

-- Авто-покупка Buy 10
_G.autoBuy10 = function(count, delay)
    count = count or 10
    delay = delay or 0.5
    
    if not buy10Btn then
        print("! Кнопка Buy 10 ($20000) не найдена!")
        print("Возможные кнопки:")
        for _, info in ipairs(allButtons) do
            print("  -", info.btn.Name, ":", info.text)
        end
        return
    end
    
    print("\nПокупаем", count, "раз по 10 кейсов Cosmic...")
    print("Цена за раз: $20000")
    print("Общая цена: $" .. (count * 20000))
    
    for i = 1, count do
        local ok = clickButton(buy10Btn)
        if ok then
            print("  [", i, "/", count, "] Успешно")
        else
            print("  [", i, "/", count, "] Не удалось кликнуть")
        end
        task.wait(delay)
    end
    
    print("Готово! Куплено кейсов:", count * 10)
end

-- Авто-покупка Buy 1 (если мало денег)
_G.autoBuy1 = function(count, delay)
    count = count or 50
    delay = delay or 0.3
    
    if not buy1Btn then
        print("! Кнопка Buy 1 ($2000) не найдена!")
        return
    end
    
    print("\nПокупаем", count, "раз по 1 кейсу Cosmic...")
    
    for i = 1, count do
        clickButton(buy1Btn)
        if i % 10 == 0 then
            print("  Куплено:", i, "/", count)
        end
        task.wait(delay)
    end
    
    print("Готово! Куплено кейсов:", count)
end

-- Закрыть GUI
_G.closeCase = function()
    if closeBtn then
        clickButton(closeBtn)
        print("GUI закрыто")
    else
        print("! Кнопка Close не найдена")
    end
end

-- Показать текущие деньги
_G.showMoney = function()
    for _, gui in ipairs(player.PlayerGui:GetChildren()) do
        for _, obj in ipairs(gui:GetDescendants()) do
            if obj:IsA("TextLabel") and (obj.Name:lower():find("money") or obj.Text:find("%$")) then
                print(obj.Name, ":", obj.Text, "|", obj:GetFullName())
            end
        end
    end
end

