-- One Tap: Cosmic Case Auto-Buy (улучшенный - ловит появление GUI)
local Players = game:GetService("Players")
local player = Players.LocalPlayer

print("=" .. string.rep("=", 50))
print("  ONE TAP: COSMIC CASE AUTO-BUY v2")
print("=" .. string.rep("=", 50))
print("Скрипт активен! Открой меню Cosmic Case...")

-- Хранилище найденных кнопок
local foundButtons = {
    buy10 = nil,
    buy1 = nil,
    buy10robux = nil,
    close = nil
}

-- Функция клика
local function clickButton(btn)
    if not btn then return false end
    local ok = false
    pcall(function() btn.MouseButton1Click:Fire() ok = true end)
    pcall(function() for _,c in ipairs(getconnections(btn.MouseButton1Click)) do if c.Function then c.Function() ok=true end end end)
    pcall(function() for _,c in ipairs(getconnections(btn.Activated)) do if c.Function then c.Function() ok=true end end end)
    return ok
end

-- Сканируем объект и его детей на наличие кнопок кейса
local function scanForCaseButtons(parent, depth)
    depth = depth or 0
    if depth > 5 then return end -- не уходим слишком глубоко
    
    for _, obj in ipairs(parent:GetChildren()) do
        if obj:IsA("TextButton") or obj:IsA("ImageButton") then
            local txt = ""
            if obj:IsA("TextButton") then txt = obj.Text or "" end
            
            -- Проверяем по тексту и имени
            local txtLow = txt:lower()
            local nameLow = obj.Name:lower()
            
            -- Buy 10 за деньги ($20000)
            if (txt:find("20000") or txt:find("20") and txt:find("000")) and not txt:find("2000") then
                if not foundButtons.buy10 then
                    foundButtons.buy10 = obj
                    print("\n[✓] НАЙДЕНА КНОПКА Buy 10 ($20000):")
                    print("    Имя:", obj.Name)
                    print("    Текст:", txt)
                    print("    Путь:", obj:GetFullName())
                end
            end
            
            -- Buy 1 за деньги ($2000)
            if txt:find("2000") and not txt:find("20000") then
                if not foundButtons.buy1 then
                    foundButtons.buy1 = obj
                    print("\n[✓] НАЙДЕНА КНОПКА Buy 1 ($2000):")
                    print("    Имя:", obj.Name)
                    print("    Текст:", txt)
                end
            end
            
            -- Buy 10 за робуксы (1000 R$)
            if txt:find("1000") and (txt:find("R%$") or txt:find("RS") or txt:find("R ")) then
                if not foundButtons.buy10robux then
                    foundButtons.buy10robux = obj
                    print("\n[✓] НАЙДЕНА КНОПКА Buy 10 (1000 R$):")
                    print("    Имя:", obj.Name)
                    print("    Текст:", txt)
                end
            end
            
            -- Close
            if txtLow:find("close") or nameLow:find("close") then
                if not foundButtons.close then
                    foundButtons.close = obj
                    print("\n[✓] НАЙДЕНА КНОПКА Close:")
                    print("    Имя:", obj.Name)
                end
            end
        end
        
        -- Рекурсивно сканируем детей
        scanForCaseButtons(obj, depth + 1)
    end
end

-- Слушаем появление новых объектов в PlayerGui
player.PlayerGui.DescendantAdded:Connect(function(obj)
    -- Если появляется что-то связанное с кейсами
    local name = obj.Name:lower()
    if name:find("case") or name:find("cosmic") or name:find("buy") 
       or name:find("open") or name:find("20000") or name:find("2000") then
        task.wait(0.1) -- даём время на загрузку текста
        scanForCaseButtons(obj.Parent)
    end
end)

-- Также периодически сканируем всё PlayerGui
task.spawn(function()
    while true do
        scanForCaseButtons(player.PlayerGui)
        task.wait(2)
    end
end)

-- === КОМАНДЫ ===

_G.buyCosmic10 = function(count, delay)
    count = count or 10
    delay = delay or 0.5
    
    if not foundButtons.buy10 then
        print("! Кнопка Buy 10 ($20000) ещё не найдена!")
        print("Открой меню Cosmic Case сначала.")
        return
    end
    
    print("\n>>> Покупаем", count, "раз по 10 кейсов Cosmic...")
    print(">>> Всего будет куплено:", count * 10, "кейсов")
    
    for i = 1, count do
        local ok = clickButton(foundButtons.buy10)
        print("  [" .. i .. "/" .. count .. "]", ok and "✓" or "✗")
        task.wait(delay)
    end
    
    print(">>> Готово!")
end

_G.buyCosmic1 = function(count, delay)
    count = count or 50
    delay = delay or 0.3
    
    if not foundButtons.buy1 then
        print("! Кнопка Buy 1 ($2000) ещё не найдена!")
        return
    end
    
    print("\n>>> Покупаем", count, "одиночных кейсов...")
    for i = 1, count do
        clickButton(foundButtons.buy1)
        if i % 10 == 0 then print("  Куплено:", i) end
        task.wait(delay)
    end
    print(">>> Готово!")
end

_G.closeCosmic = function()
    if foundButtons.close then
        clickButton(foundButtons.close)
        print("GUI закрыто")
    else
        print("! Кнопка Close не найдена")
    end
end

_G.status = function()
    print("\n[СТАТУС КНОПОК]:")
    print("  Buy 10 ($20000):", foundButtons.buy10 and "НАЙДЕНА (" .. foundButtons.buy10.Name .. ")" or "НЕТ")
    print("  Buy 1 ($2000):", foundButtons.buy1 and "НАЙДЕНА (" .. foundButtons.buy1.Name .. ")" or "НЕТ")
    print("  Buy 10 (1000 R$):", foundButtons.buy10robux and "НАЙДЕНА" or "НЕТ")
    print("  Close:", foundButtons.close and "НАЙДЕНА" or "НЕТ")
end

