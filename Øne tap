-- One Tap: Auto Case Opening (точечный)
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local player = Players.LocalPlayer

print("=" .. string.rep("=", 50))
print("  ONE TAP: АВТО-КЕЙСЫ")
print("=" .. string.rep("=", 50))

-- Находим CaseOpening GUI
local caseGui = player.PlayerGui:FindFirstChild("GameInterface")
    and player.PlayerGui.GameInterface:FindFirstChild("CaseOpening")

if not caseGui then
    print("! CaseOpening GUI не найден")
    return
end

local mainFrame = caseGui:FindFirstChild("Main")
local casesFrame = mainFrame and mainFrame:FindFirstChild("Cases")

if not casesFrame then
    print("! Cases frame не найден")
    return
end

print("\n[НАЙДЕНО GUI КЕЙСОВ]")
print("Путь:", casesFrame:GetFullName())

-- Показываем все дочерние элементы
print("\n[ДОСТУПНЫЕ ПОКУПКИ]:")
for _, child in ipairs(casesFrame:GetChildren()) do
    print("  -", child.Name)
    for _, sub in ipairs(child:GetChildren()) do
        if sub:IsA("TextLabel") or sub:IsA("TextButton") or sub:IsA("ImageButton") then
            print("    ", sub.Name, ":", sub.Text or "[ImageButton]")
        end
    end
end

-- Находим кнопки покупки
local buyButtons = {}
for _, parent in ipairs(casesFrame:GetChildren()) do
    for _, btn in ipairs(parent:GetDescendants()) do
        if btn:IsA("TextButton") or btn:IsA("ImageButton") then
            table.insert(buyButtons, {
                btn = btn,
                parent = parent.Name,
                path = btn:GetFullName()
            })
        end
    end
end

print("\n[НАЙДЕНО КНОПОК]:", #buyButtons)
for _, info in ipairs(buyButtons) do
    print("  ", info.parent, "->", info.btn.Name)
end

-- === ФУНКЦИИ ДЛЯ КОНСОЛИ ===

-- Авто-клик по кнопке покупки
_G.buyCases = function(amount, count)
    count = count or 1
    amount = amount or "1" -- "1", "3", "10"
    
    local target = casesFrame:FindFirstChild("BuyMoney") and casesFrame.BuyMoney:FindFirstChild(amount)
    if not target then
        print("! Кнопка BuyMoney." .. amount .. " не найдена")
        return
    end
    
    local btn = nil
    for _, child in ipairs(target:GetDescendants()) do
        if child:IsA("TextButton") or child:IsA("ImageButton") then
            btn = child
            break
        end
    end
    
    if not btn then
        print("! Кнопка не найдена в BuyMoney." .. amount)
        return
    end
    
    print("Покупаем", count, "раз по", amount, "кейс(ов)...")
    for i = 1, count do
        -- Имитируем разные типы кликов
        pcall(function() btn.MouseButton1Click:Fire() end)
        pcall(function() 
            if btn.Activated then btn.Activated:Fire() end
        end)
        pcall(function()
            -- Пробуем найти и вызвать обработчик напрямую
            for _, conn in ipairs(getconnections(btn.MouseButton1Click)) do
                if conn.Function then
                    conn.Function()
                end
            end
        end)
        
        if i % 10 == 0 then
            print("  Куплено:", i, "/", count)
        end
        task.wait(0.2)
    end
    print("Готово!")
end

-- Быстрое открытие (если есть кнопка "Open" отдельно)
_G.openCases = function(count)
    count = count or 10
    -- Ищем кнопку открытия в CaseOpening GUI
    local openBtn = nil
    for _, obj in ipairs(caseGui:GetDescendants()) do
        if (obj:IsA("TextButton") or obj:IsA("ImageButton")) and 
           (obj.Name:lower():find("open") or (obj.Text or ""):lower():find("open")) then
            openBtn = obj
            print("Найдена кнопка открытия:", obj.Name)
            break
        end
    end
    
    if not openBtn then
        print("! Кнопка Open не найдена")
        return
    end
    
    for i = 1, count do
        pcall(function() openBtn.MouseButton1Click:Fire() end)
        pcall(function() 
            for _, conn in ipairs(getconnections(openBtn.MouseButton1Click)) do
                if conn.Function then conn.Function() end
            end
        end)
        task.wait(0.3)
        if i % 10 == 0 then print("Открыто:", i, "/", count) end
    end
end

-- Показать текущую валюту
_G.showMoney = function()
    for _, obj in ipairs(player.PlayerGui:GetDescendants()) do
        if obj:IsA("TextLabel") and obj.Name == "Money" then
            print("Валюта:", obj.Text, "| Путь:", obj:GetFullName())
        end
    end
end

print("\n" .. string.rep("=", 52))
print("КОМАНДЫ:")
print("  buyCases('1', 50)   -- купить 50 раз по 1 кейсу")
